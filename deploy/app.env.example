# /etc/chauffeur-kotlin/app.env  (mode 0640, root:deploy) -- created by bootstrap.sh; never commit the real file.
# One file feeds both `route` and `migration`: every section is required by the application.
GOOGLE_CLOUD__MAPS_API_KEY=replace-me

DATABASE__USER=chauffeur
DATABASE__PASSWORD=replace-me
DATABASE__NAME=chauffeur
DATABASE__HOST=database
DATABASE__PORT=5432

MIGRATION__USER=chauffeur
MIGRATION__PASSWORD=replace-me
MIGRATION__NAME=chauffeur
MIGRATION__HOST=database
MIGRATION__PORT=5432
